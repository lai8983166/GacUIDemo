<Folder>
  <Instance name="CustomControlTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="punkskin::CustomControlTemplate" ref.Styles="res://PunkSkin/Style">
      <ControlTemplate MinSizeLimitation="LimitToElementAndChildren"/>
    </Instance>
  </Instance>

  <Instance name="TooltipTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="punkskin::TooltipTemplate" ref.Styles="res://PunkSkin/Style">
      <WindowTemplate ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <Bounds AlignmentToParent="left:3 top:3 right:0 bottom:0">
          <SolidBackground Color="#000000"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:3 bottom:3">
          <SolidBackground Color="#FFFFFF"/>
          <SolidBorder Color="#000000"/>
          <Bounds ref.Name="container" AlignmentToParent="left:8 top:4 right:8 bottom:4"/>
        </Bounds>
      </WindowTemplate>
    </Instance>
  </Instance>

  <Instance name="TitleBarButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="punkskin::TitleBarButtonTemplate" ref.Styles="res://PunkSkin/Style">
      <ButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground ref.Style="titleBarButtonBackground"/>
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
      </ButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="TitleBarCloseButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="punkskin::TitleBarCloseButtonTemplate" ref.Styles="res://PunkSkin/Style">
      <ButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <SolidBackground ref.Style="titleBarCloseBackground"/>
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
      </ButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="CustomFrameWindowTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="punkskin::CustomFrameWindowTemplate" ref.Styles="res://PunkSkin/Style">
      <WindowTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.CustomFrameEnabled>true</att.CustomFrameEnabled>
        <att.TooltipTemplate>punkskin::TooltipTemplate</att.TooltipTemplate>

        <ev.TitleBarChanged-eval>
          <![CDATA[
            {
              if (self.TitleBar)
              {
                contentTable.SetRowOption(0, {composeType:MinSize});
              }
              else
              {
                contentTable.SetRowOption(0, {composeType:Absolute absolute:0});
              }
            }
          ]]>
        </ev.TitleBarChanged-eval>

        <ev.CustomFramePaddingChanged-eval>
          <![CDATA[
            {
              var margin = self.CustomFramePadding;
              frameTable.SetRowOption(0, {composeType:Absolute absolute:margin.top});
              frameTable.SetRowOption(2, {composeType:Absolute absolute:margin.bottom});
              frameTable.SetColumnOption(0, {composeType:Absolute absolute:margin.left});
              frameTable.SetColumnOption(2, {composeType:Absolute absolute:margin.right});
            }
          ]]>
        </ev.CustomFramePaddingChanged-eval>

        <SolidBackground Color="#000000"/>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <Table ref.Name="frameTable" AlignmentToParent="left:0 top:0 right:0 bottom:0">
            <att.Rows>
              <CellOption>composeType:Absolute absolute:0</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
              <CellOption>composeType:Absolute absolute:0</CellOption>
            </att.Rows>
            <att.Columns>
              <CellOption>composeType:Absolute absolute:0</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
              <CellOption>composeType:Absolute absolute:0</CellOption>
            </att.Columns>

            <Cell Site="row:0 column:0" AssociatedHitTestResult="BorderLeftTop"/>
            <Cell Site="row:0 column:2" AssociatedHitTestResult="BorderRightTop"/>
            <Cell Site="row:2 column:0" AssociatedHitTestResult="BorderLeftBottom"/>
            <Cell Site="row:2 column:2" AssociatedHitTestResult="BorderRightBottom"/>

            <Cell Site="row:1 column:0" AssociatedHitTestResult="BorderLeft"/>
            <Cell Site="row:1 column:2" AssociatedHitTestResult="BorderRight"/>
            <Cell Site="row:0 column:1" AssociatedHitTestResult="BorderTop"/>
            <Cell Site="row:2 column:1" AssociatedHitTestResult="BorderBottom"/>
          </Table>

          <Table ref.Name="contentTable" AlignmentToParent-bind="self.CustomFramePadding">
            <att.Rows>
              <CellOption>composeType:MinSize</CellOption>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
            </att.Rows>
            <att.Columns>
              <CellOption>composeType:Percentage percentage:1.0</CellOption>
            </att.Columns>

            <Cell Site="row:0 column:0" AssociatedHitTestResult="Title">
              <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
                <SolidBackground Color="#151515"/>
                <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
                  <att.Rows>
                    <CellOption>composeType:Percentage percentage:1.0</CellOption>
                    <CellOption>composeType:Absolute absolute:4</CellOption>
                  </att.Rows>
                  <att.Columns>
                    <CellOption>composeType:Percentage percentage:1.0</CellOption>
                  </att.Columns>

                  <Cell Site="row:0 column:0">
                    <Table AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElementAndChildren">
                      <att.Rows>
                        <CellOption>composeType:Percentage percentage:1.0</CellOption>
                        <CellOption>composeType:MinSize</CellOption>
                        <CellOption>composeType:Percentage percentage:1.0</CellOption>
                      </att.Rows>
                      <att.Columns>
                        <CellOption>composeType:MinSize</CellOption>
                        <CellOption>composeType:MinSize</CellOption>
                        <CellOption>composeType:Percentage percentage:1.0</CellOption>
                        <CellOption>composeType:MinSize</CellOption>
                        <CellOption>composeType:MinSize</CellOption>
                        <CellOption>composeType:MinSize</CellOption>
                      </att.Columns>

                      <Cell Site="row:1 column:0">
                        <Bounds AlignmentToParent="left:10 top:0 right:2 bottom:0">
                          <SolidLabel Text="◆" Color="#E8151C" Font="size:14 bold:true antialias:true" VerticalAlignment="Center"/>
                        </Bounds>
                      </Cell>
                      <Cell Site="row:1 column:1">
                        <Bounds AlignmentToParent="left:8 top:0 right:8 bottom:0">
                          <SolidLabel ref.Style="windowTitle" Text-bind="self.Text" Ellipse="true" Font="size:14 bold:true antialias:true" VerticalAlignment="Center"/>
                        </Bounds>
                      </Cell>

                      <Cell Site="row:0 column:3 rowSpan:3">
                        <att.AssociatedHitTestResult-bind>self.MinimizedBox ? ButtonMinimum : NoDecision</att.AssociatedHitTestResult-bind>
                        <Button AutoFocus="false" ControlTemplate="punkskin::TitleBarButtonTemplate">
                          <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                          <att.Enabled-bind>self.MinimizedBox</att.Enabled-bind>
                          <att.Visible-bind>self.MinimizedBox or self.MaximizedBox</att.Visible-bind>
                          <att.ContainerComposition-set>
                            <BoundsComposition AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:46 y:32" MinSizeLimitation="LimitToElement">
                              <Polygon ref.Style="titleBarGlyph" Size="x:46 y:32">
                                <att.Points>
                                  <Point>x:17 y:21</Point>
                                  <Point>x:29 y:21</Point>
                                  <Point>x:29 y:23</Point>
                                  <Point>x:17 y:23</Point>
                                </att.Points>
                              </Polygon>
                            </BoundsComposition>
                          </att.ContainerComposition-set>
                        </Button>
                      </Cell>
                      <Cell Site="row:0 column:4 rowSpan:3">
                        <att.AssociatedHitTestResult-bind>self.MaximizedBox ? ButtonMaximum : NoDecision</att.AssociatedHitTestResult-bind>
                        <Button AutoFocus="false" ControlTemplate="punkskin::TitleBarButtonTemplate">
                          <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                          <att.Enabled-bind>self.MaximizedBox</att.Enabled-bind>
                          <att.Visible-bind>self.MinimizedBox or self.MaximizedBox</att.Visible-bind>
                          <att.ContainerComposition-set>
                            <BoundsComposition AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:46 y:32" MinSizeLimitation="LimitToElement">
                              <Polygon ref.Style="titleBarGlyph" Size="x:46 y:32">
                                <att.Points>
                                  <Point>x:16 y:8</Point>
                                  <Point>x:30 y:8</Point>
                                  <Point>x:30 y:22</Point>
                                  <Point>x:16 y:22</Point>
                                  <Point>x:16 y:8</Point>

                                  <Point>x:18 y:10</Point>
                                  <Point>x:18 y:20</Point>
                                  <Point>x:28 y:20</Point>
                                  <Point>x:28 y:10</Point>
                                  <Point>x:18 y:10</Point>
                                </att.Points>
                              </Polygon>
                            </BoundsComposition>
                          </att.ContainerComposition-set>
                        </Button>
                      </Cell>
                      <Cell Site="row:0 column:5 rowSpan:3" AssociatedHitTestResult="ButtonClose">
                        <Button AutoFocus="false" ControlTemplate="punkskin::TitleBarCloseButtonTemplate">
                          <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                          <att.ContainerComposition-set>
                            <BoundsComposition AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:46 y:32" MinSizeLimitation="LimitToElement">
                              <Polygon ref.Style="titleBarGlyph" Size="x:46 y:32">
                                <att.Points>
                                  <Point>x:16 y:9</Point>
                                  <Point>x:18 y:9</Point>
                                  <Point>x:28 y:19</Point>
                                  <Point>x:26 y:19</Point>

                                  <Point>x:26 y:9</Point>
                                  <Point>x:28 y:9</Point>
                                  <Point>x:18 y:19</Point>
                                  <Point>x:16 y:19</Point>
                                </att.Points>
                              </Polygon>
                            </BoundsComposition>
                          </att.ContainerComposition-set>
                        </Button>
                      </Cell>
                    </Table>
                  </Cell>

                  <Cell Site="row:1 column:0">
                    <SolidBackground Color="#E8151C"/>
                  </Cell>
                </Table>
              </Bounds>
            </Cell>

            <Cell Site="row:1 column:0" AssociatedHitTestResult="Client">
              <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
                <SolidBackground Color="#EFEAE0"/>
                <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
              </Bounds>
            </Cell>
          </Table>
        </Bounds>
      </WindowTemplate>
    </Instance>
  </Instance>
</Folder>
