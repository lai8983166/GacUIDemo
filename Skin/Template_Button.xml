<Folder>
  <Instance name="ButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="punkskin::ButtonTemplate" ref.Styles="res://PunkSkin/Style">
      <ButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <Bounds AlignmentToParent="left:4 top:4 right:0 bottom:0">
          <SolidBackground ref.Style="buttonShadow"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:4 bottom:4">
          <SolidBackground ref.Style="buttonBody"/>
          <SolidBorder Color="#000000"/>
          <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1" Visible-bind="self.Focused">
            <FocusRectangle/>
          </Bounds>
          <Bounds AlignmentToParent="left:14 top:6 right:14 bottom:6">
            <SolidLabel ref.Style="buttonText" Text-bind="self.Text" Font="size:14 bold:true antialias:true" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
          </Bounds>
        </Bounds>
      </ButtonTemplate>
    </Instance>
  </Instance>

  <Instance name="CheckBoxTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="punkskin::CheckBoxTemplate" ref.Styles="res://PunkSkin/Style">
      <SelectableButtonTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Rows>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
            <CellOption>composeType:MinSize</CellOption>
            <CellOption>composeType:Percentage percentage:1.0</CellOption>
          </att.Rows>
          <att.Columns>
            <CellOption>composeType:MinSize</CellOption>
            <CellOption>composeType:MinSize</CellOption>
          </att.Columns>

          <Cell Site="row:1 column:0">
            <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" PreferredMinSize="x:44 y:24" MinSizeLimitation="LimitToElement">
              <SolidBackground ref.Style="switchTrack" Shape="shapeType:Ellipse"/>
              <SolidBorder Color="#000000" Shape="shapeType:Ellipse"/>
              <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
                <SolidBorder Color="#000000" Shape="shapeType:Ellipse"/>
                <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
                  <SolidBorder Color="#000000" Shape="shapeType:Ellipse"/>
                </Bounds>
              </Bounds>

              <Table AlignmentToParent="left:0 top:0 right:0 bottom:0">
                <att.Rows>
                  <CellOption>composeType:Percentage percentage:0.5</CellOption>
                  <CellOption>composeType:MinSize</CellOption>
                  <CellOption>composeType:Percentage percentage:0.5</CellOption>
                </att.Rows>
                <att.Columns>
                  <CellOption>composeType:Percentage percentage:1.0</CellOption>
                </att.Columns>

                <Cell Site="row:1 column:0">
                  <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
                    <Bounds Visible-bind="not self.Selected" AlignmentToParent="left:2 top:-1 right:-1 bottom:-1" PreferredMinSize="x:18 y:18">
                      <SolidBackground ref.Style="switchThumb" Shape="shapeType:Ellipse"/>
                      <SolidBorder ref.Style="switchThumbBorder" Shape="shapeType:Ellipse"/>
                    </Bounds>
                    <Bounds Visible-bind="self.Selected" AlignmentToParent="left:24 top:-1 right:-1 bottom:-1" PreferredMinSize="x:18 y:18">
                      <SolidBackground ref.Style="switchThumb" Shape="shapeType:Ellipse"/>
                      <SolidBorder ref.Style="switchThumbBorder" Shape="shapeType:Ellipse"/>
                    </Bounds>
                  </Bounds>
                </Cell>
              </Table>
            </Bounds>
          </Cell>

          <Cell Site="row:0 column:1 rowSpan:3">
            <Bounds AlignmentToParent="left:12 top:0 right:0 bottom:0">
              <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" Visible-bind="self.Focused">
                <FocusRectangle/>
              </Bounds>
              <Bounds AlignmentToParent="left:2 top:2 right:2 bottom:2">
                <SolidLabel ref.Style="controlText" Text-bind="self.Text" Font-bind="self.Font" VerticalAlignment="Center"/>
                <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
              </Bounds>
            </Bounds>
          </Cell>
        </Table>
      </SelectableButtonTemplate>
    </Instance>
  </Instance>
</Folder>
