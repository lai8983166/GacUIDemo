        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:4 bottom:4" MinSizeLimitation="LimitToElementAndChildren">
          <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElement">
            <SolidBackground ref.Style="inputBody"/>
          </Bounds>
          <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElement">
            <SolidBorder Color="#000000"/>
          </Bounds>
          <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1" MinSizeLimitation="LimitToElement">
            <SolidBorder Color="#000000"/>
          </Bounds>
          <Bounds AlignmentToParent="left:2 top:2 right:2 bottom:2" MinSizeLimitation="LimitToElement">
            <SolidBorder Color="#000000"/>
          </Bounds>
          <Bounds ref.Name="container" AlignmentToParent="left:12 top:8 right:12 bottom:8"/>
        </Bounds>
      </DocumentLabelTemplate>
    </Instance>
