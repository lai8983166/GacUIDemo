  <Instance name="DocumentViewerTemplateResource">
    <Instance ref.CodeBehind="true" ref.Class="punkskin::DocumentViewerTemplate" ref.Styles="res://PunkSkin/Style">
      <ref.Members><![CDATA[
        @cpp:UserImpl
        @cpp:Private
        func InitFx(): void {}
      ]]></ref.Members>
      <ref.Ctor><![CDATA[
        {
          self.InitFx();
        }
      ]]></ref.Ctor>
      <DocumentViewerTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <att.BaselineDocument-eval>punkskin::CreateBaselineDocument()</att.BaselineDocument-eval>
        <att.CaretColor-eval>cast Color "#E8151C"</att.CaretColor-eval>
        <att.ContainerComposition-eval>look.ContainerComposition</att.ContainerComposition-eval>
        <att.HorizontalScroll-eval>look.HScroll</att.HorizontalScroll-eval>
        <att.VerticalScroll-eval>look.VScroll</att.VerticalScroll-eval>

        <!-- 硬投影 4px 4px 0，聚焦时 #000 -> #E8151C 由 C++ 补间 -->
        <Bounds ref.Name="shadowBounds" AlignmentToParent="left:4 top:4 right:0 bottom:0" MinSizeLimitation="LimitToElement">
          <SolidBackground ref.Style="inputShadow"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:4 bottom:4" MinSizeLimitation="LimitToElementAndChildren">
          <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElement">
            <SolidBackground ref.Style="inputBody"/>
          </Bounds>
          <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElement">
            <SolidBorder Color="#000000"/>
          </Bounds>
          <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1" MinSizeLimitation="LimitToElement">
            <SolidBorder Color="#000000"/>
          </Bounds>
          <Bounds AlignmentToParent="left:2 top:2 right:2 bottom:2" MinSizeLimitation="LimitToElement">
            <SolidBorder Color="#000000"/>
          </Bounds>
          <CommonScrollViewLook ref.Name="look" AlignmentToParent="left:3 top:3 right:3 bottom:3">
            <att.HScrollTemplate>punkskin::HScrollTemplate</att.HScrollTemplate>
            <att.VScrollTemplate>punkskin::VScrollTemplate</att.VScrollTemplate>
            <att.DefaultScrollSize>18</att.DefaultScrollSize>
          </CommonScrollViewLook>
        </Bounds>
      </DocumentViewerTemplate>
    </Instance>
  </Instance>
