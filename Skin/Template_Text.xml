<Folder>
  <Instance name="DocumentLabelTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="punkskin::DocumentLabelTemplate" ref.Styles="res://PunkSkin/Style">
      <DocumentLabelTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <att.BaselineDocument-eval>punkskin::CreateBaselineDocument()</att.BaselineDocument-eval>
        <att.CaretColor-eval>cast Color "#E8151C"</att.CaretColor-eval>
      </DocumentLabelTemplate>
    </Instance>
  </Instance>

  <Instance name="DocumentTextBoxTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="punkskin::DocumentTextBoxTemplate" ref.Styles="res://PunkSkin/Style">
      <DocumentLabelTemplate ref.Name="self" ContainerComposition-ref="container" MinSizeLimitation="LimitToElementAndChildren">
        <att.BaselineDocument-eval>punkskin::CreateBaselineDocument()</att.BaselineDocument-eval>
        <att.CaretColor-eval>cast Color "#E8151C"</att.CaretColor-eval>

        <Bounds AlignmentToParent="left:4 top:4 right:0 bottom:0">
          <SolidBackground ref.Style="inputShadow"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:4 bottom:4">
          <SolidBackground ref.Style="inputBody"/>
          <SolidBorder Color="#000000"/>
          <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
            <SolidBorder Color="#000000"/>
            <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
              <SolidBorder Color="#000000"/>
            </Bounds>
          </Bounds>
          <Bounds ref.Name="container" AlignmentToParent="left:10 top:8 right:10 bottom:8"/>
        </Bounds>
      </DocumentLabelTemplate>
    </Instance>
  </Instance>

  <Instance name="DocumentViewerTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="punkskin::DocumentViewerTemplate" ref.Styles="res://PunkSkin/Style">
      <DocumentViewerTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <att.BaselineDocument-eval>punkskin::CreateBaselineDocument()</att.BaselineDocument-eval>
        <att.CaretColor-eval>cast Color "#E8151C"</att.CaretColor-eval>
        <att.ContainerComposition-eval>look.ContainerComposition</att.ContainerComposition-eval>
        <att.HorizontalScroll-eval>look.HScroll</att.HorizontalScroll-eval>
        <att.VerticalScroll-eval>look.VScroll</att.VerticalScroll-eval>

        <Bounds AlignmentToParent="left:4 top:4 right:0 bottom:0">
          <SolidBackground ref.Style="inputShadow"/>
        </Bounds>
        <Bounds AlignmentToParent="left:0 top:0 right:4 bottom:4">
          <SolidBackground ref.Style="inputBody"/>
          <SolidBorder Color="#000000"/>
          <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
            <SolidBorder Color="#000000"/>
            <Bounds AlignmentToParent="left:1 top:1 right:1 bottom:1">
              <SolidBorder Color="#000000"/>
            </Bounds>
          </Bounds>
          <CommonScrollViewLook ref.Name="look" AlignmentToParent="left:3 top:3 right:3 bottom:3">
            <att.HScrollTemplate>punkskin::HScrollTemplate</att.HScrollTemplate>
            <att.VScrollTemplate>punkskin::VScrollTemplate</att.VScrollTemplate>
            <att.DefaultScrollSize>18</att.DefaultScrollSize>
          </CommonScrollViewLook>
        </Bounds>
      </DocumentViewerTemplate>
    </Instance>
  </Instance>
</Folder>
